# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  NEXTFOLIO — Variabili d'ambiente                                        ║
# ║                                                                          ║
# ║  Modalità deploy (scegline una):                                         ║
# ║                                                                          ║
# ║  A) Cloudflare Tunnel (consigliato — nessuna porta aperta)               ║
# ║     COMPOSE_PROFILES=cloudflare docker compose up -d                     ║
# ║     → imposta CLOUDFLARE_TUNNEL_TOKEN qui sotto                          ║
# ║                                                                          ║
# ║  B) HTTPS diretto con Let's Encrypt                                      ║
# ║     docker compose -f docker-compose.yml \                               ║
# ║                    -f docker-compose.https.yml up -d                     ║
# ║     → segui le istruzioni in docker-compose.https.yml                    ║
# ║                                                                          ║
# ║  C) HTTP locale / LAN                                                    ║
# ║     Decommenta ports nel docker-compose.yml, poi: docker compose up -d   ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=nextfolio
POSTGRES_PASSWORD=           # REQUIRED — genera con: openssl rand -hex 16
POSTGRES_DB=nextfolio

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=              # REQUIRED — genera con: openssl rand -hex 16

# ── JWT / Sicurezza ───────────────────────────────────────────────────────────
SECRET_KEY=                  # REQUIRED — genera con: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false

# URL pubblico dell'app (usato nei link email)
APP_URL=https://tuodominio.example.com

# CORS — dominio/i autorizzati a chiamare le API (separati da virgola)
CORS_ORIGINS=https://tuodominio.example.com

# Host header accettati dal backend (opzionale — * per disabilitare il controllo)
ALLOWED_HOSTS=tuodominio.example.com

# ── Modalità A: Cloudflare Tunnel ─────────────────────────────────────────────
# 1. Crea un tunnel su https://one.dash.cloudflare.com → Networks → Tunnels
# 2. Copia il token dal comando di installazione
# 3. Nel dashboard configura il servizio come: http://frontend
# 4. Avvia con: COMPOSE_PROFILES=cloudflare docker compose up -d
CLOUDFLARE_TUNNEL_TOKEN=     # opzionale — necessario solo con modalità A

# ── Sentry (opzionale) ───────────────────────────────────────────────────────
SENTRY_DSN=                  # opzionale — DSN dal dashboard Sentry (backend)
VITE_SENTRY_DSN=             # opzionale — DSN dal dashboard Sentry (frontend)

# ── Market data ───────────────────────────────────────────────────────────────
COINGECKO_API_KEY=           # opzionale — aumenta rate limit CoinGecko
OPENFIGI_APY_KEY=            # opzionale — aumenta rate limit OpenFIGI

# ── Email SMTP ────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@tuodominio.example.com
